<xri version="1.0">
   <description>
      <p>SmartCrop - synchronized automatic crop of registered master frames (black borders, noisy stacking edges, optional rotated crop).</p>
   </description>
   <platform os="all" arch="noarch" version="1.8.9:1.9.99">
      <package fileName="SmartCrop-1.2.1-20261009.zip" sha1="11da2c8a46600fb46ea0b516cdd4f0865c025250" type="script" releaseDate="20261009">
         <title>SmartCrop 1.2.1</title>
         <description>
            <p>Registration of unregistered masters (by stars, or by astrometric solutions as a fallback; the reference is chosen automatically). The crop is searched at any angle (no 10-degree limit). Preview inside the script window.</p>
            <p>After installation the script is available as Script &gt; Utilities &gt; SmartCrop.</p>
         </description>
      </package>
   </platform>
